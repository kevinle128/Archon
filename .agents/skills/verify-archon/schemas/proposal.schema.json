{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-verification:proposal:1",
  "title": "Project verification selection proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "base_sha", "head_sha", "changed_paths", "affected_behaviors", "coverage_gaps"],
  "properties": {
    "version": {"const": 1}, "base_sha": {"$ref": "#/$defs/gitSha"}, "head_sha": {"$ref": "#/$defs/gitSha"},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "affected_behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/affectedBehavior"}},
    "coverage_gaps": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "gitSha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?\\[])(?!.*//).+$"},
    "affectedBehavior": {
      "type": "object", "additionalProperties": false, "required": ["id", "confidence", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "confidence": {"enum": ["high", "medium", "low"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
