{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-verification:contract:1",
  "title": "Project verification contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "skill", "entrypoint", "schemas"],
  "properties": {
    "protocol": {"const": "project-verification"},
    "version": {"const": 1},
    "skill": {"$ref": "#/$defs/id"},
    "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "gaps", "snapshot", "proposal", "selection", "result"],
      "properties": {
        "catalog": {"$ref": "#/$defs/path"},
        "gaps": {"$ref": "#/$defs/path"},
        "snapshot": {"$ref": "#/$defs/path"},
        "proposal": {"$ref": "#/$defs/path"},
        "selection": {"$ref": "#/$defs/path"},
        "result": {"$ref": "#/$defs/path"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?\\[])(?!.*//).+$"}
  }
}
