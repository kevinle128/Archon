  "criteria": [
    {
      "id": "row-anatomy",
      "states": [
        "row-closed"
      ],
      "source": "_bmad-output/planning-artifacts/ux-designs/ux-Archon-agent-node-room-2026-09-09/DESIGN.md#components",
      "expected": "One scan line, chevron then status then family then target then facts; legible text, balanced spacing, and visible state glyph. Compare style and order, not fixture text."
    },
    {
      "id": "raw-disclosure",
      "states": [
        "raw-open"
      ],
      "source": "_bmad-output/planning-artifacts/ux-designs/ux-Archon-agent-node-room-2026-09-09/DESIGN.md#components",
      "expected": "Raw control at the right of the body bar, open suffix, inset wrapped JSON, readable foreground, minimum 24 px target. Final DESIGN overrides the stale mockup tertiary JSON and 22 px row."
    },
    {
      "id": "ask-card",
      "states": [
        "ask-pending"
      ],
      "source": "_bmad-output/specs/spec-workflow-run-view-hitl/ux-design.md#core-user-experience",
      "expected": "Warning-toned pending card, readable question, selectable options and reachable Submit; no content or controls clipped in the selected card."
    },
    {
      "id": "assistant-report",
      "states": [
        "assistant-report"
      ],
      "source": "_bmad-output/specs/spec-agent-node-room/SPEC.md#read-half",
      "expected": "One assistant block carries the ASSISTANT label and readable Markdown report text with no JSON envelope, braces, or serialized quoting; styling matches the surface's other assistant text. Compare presentation, not fixture wording."
    },
    {
      "id": "runtime-graph",
      "states": [
        "runtime-graph"
      ],
      "source": "_bmad-output/specs/spec-workflow-run-view-hitl/ux-mockup/README.md#the-graph-renderer",
      "expected": "The runtime graph fills the run view with status-marked node cards, connecting edges, and zoom and fit controls; no minimap is present. Compare structure and controls, not node count or labels."
    },
    {
      "id": "queue-anatomy",
      "states": [
        "queue-waiting"
      ],
      "source": "claude-design/design_handoff_node_room_transcript_steering/README.md#queue-band--restructured",
      "expected": "A full-width waiting queue band has an interactive expanded header with caret and count, one-based ordinals, a visible next-item inset marker, and sans-serif human message text. A waiting row does not show the transcript-delivery word sent. Ignore provider-specific per-item Send now controls."
    },
    {
      "id": "layout-and-focus",
      "states": [
        "row-closed",
        "raw-open",
        "ask-pending",
        "queue-waiting"
      ],
      "source": "_bmad-output/planning-artifacts/ux-designs/ux-Archon-agent-node-room-2026-09-09/EXPERIENCE.md#accessibility-floor",
      "expected": "Required content fits the measured region; keyboard focus is visible; desktop and narrow states remain readable. Check only the selected room/card, not future mockup features."
    }
  ],
  "surfaces": [
    "console",
    "legacy"
  ],
  "states": [
    "row-closed",
    "raw-open",
    "ask-pending",
    "assistant-report",
    "runtime-graph",
    "queue-waiting"
  ],
  "viewports": [
    {
      "width": 1440,
      "height": 1000
    },
    {
      "width": 390,
      "height": 844
    }
  ],
  "desktop_room_width": 460,
  "theme": "dark",
  "device_scale_factor": 1,
  "zoom": 1,
  "comparison": "Side-by-side review plus measured geometry; fixture text, node counts and durations differ, so no single pixel threshold is valid.",
  "accepted_differences": [
    "DESIGN.md wins over mockup-only 22 px targets and tertiary Raw text.",
    "Current semantic tokens apply separately on Console and Legacy.",
    "Mockup-only Replay, view-as, Stop and idle-after-interrupt transitions, provider-specific per-item Send now, future tool family bodies and unrelated nodes are excluded.",
    "References are resized to the measured region width; browser and region dimensions are recorded separately.",
    "Transcript-display captures come from a separate prepared run; its seeded fixture text, node names, and graph shape differ from the HITL run and mockup data."
  ],
  "width_tolerance_px": 2,
  "measurement_rules": [
    "The 2 px tolerance applies only to the desktop room width and matching actual/reference region widths. It does not apply to image height.",
    "Judge height through the configured content-fit and single-line criteria. The final DESIGN minimum target size takes precedence over older mockup row heights.",
    "Report only a mismatch to a configured criterion; do not invent additional pixel-equality rules."
  ]
}
