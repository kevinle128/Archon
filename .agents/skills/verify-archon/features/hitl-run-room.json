{
  "version": 1,
  "id": "hitl-run-room",
  "description": "Inspect executions and answer workflow Asks on Console and Legacy.",
  "impact_paths": [
    "packages/web/src/components/layout/TopNav.tsx",
    "packages/web/src/components/workflows/**",
    "packages/web/src/experiments/console/**",
    "packages/web/src/lib/agent-history*",
    "packages/web/src/lib/*ask*",
    "packages/web/src/lib/*room*",
    "packages/web/src/lib/*transcript*",
    "packages/web/src/lib/tool-presentation*",
    "packages/server/src/routes/api.ts",
    "packages/server/src/routes/schemas/workflow*",
    "packages/core/src/db/workflow-pending-interactions*",
    "packages/workflows/src/*ask*",
    "e2e/ui/agent-tool-row*",
    "e2e/ui/workflow-run-hitl*",
    "e2e/lib/playwright/**",
    "e2e/fixtures/workflows/e2e-hitl*",
    "plans/260907-1454-workflow-run-hitl-mockup-alignment/**",
    "plans/260917-1011-issue-174-readable-tool-call-row/**"
  ],
  "behaviors": [
    {
      "id": "hitl.pause-and-identity",
      "description": "CLI Ask pauses with real execution identity.",
      "priority": "P1",
      "scenarios": ["hitl.cli-pause", "hitl.loop-occurrences", "hitl.live-cli"]
    },
    {
      "id": "hitl.history",
      "description": "Selected execution shows complete recorded tool and assistant history.",
      "priority": "P1",
      "scenarios": [
        "hitl.tool-transcript",
        "hitl.console-tool-output",
        "hitl.legacy-tool-output",
        "hitl.agent-history",
        "hitl.execution-scope",
        "hitl.history-pagination",
        "hitl.history-complete"
      ]
    },
    {
      "id": "hitl.room-layout",
      "description": "Rooms are readable, resizable and return space when closed.",
      "priority": "P1",
      "scenarios": ["hitl.console-room-layout", "hitl.legacy-room-layout", "hitl.room-ratio"]
    },
    {
      "id": "hitl.room-navigation",
      "description": "Selection, deep links, mobile Back and surrounding views retain context.",
      "priority": "P1",
      "scenarios": [
        "hitl.graph-selection",
        "hitl.room-deeplink",
        "hitl.console-mobile-back",
        "hitl.legacy-mobile-back",
        "hitl.legacy-navigation",
        "hitl.artifacts-room",
        "hitl.production-controls"
      ]
    },
    {
      "id": "hitl.answer",
      "description": "Browser answers persist and CLI-origin runs continue by explicit resume, including unowned solo runs.",
      "priority": "P1",
      "impact_paths": [
        "packages/web/src/components/workflows/**",
        "packages/web/src/experiments/console/components/**",
        "packages/web/src/experiments/console/routes/RunDetailPage*",
        "packages/web/src/experiments/console/skills/runs*",
        "packages/web/src/lib/*ask*",
        "packages/core/src/db/workflow-pending-interactions*",
        "packages/workflows/src/*ask*"
      ],
      "scenarios": [
        "hitl.console-ask-submit",
        "hitl.console-unowned-ask",
        "hitl.legacy-unowned-ask"
      ]
    },
    {
      "id": "hitl.answer-authorization",
      "description": "Owned Ask mutations enforce identity and reject duplicate answers.",
      "priority": "P1",
      "scenarios": ["hitl.ask-authorization"]
    },
    {
      "id": "hitl.ask-presentation",
      "description": "Drafts, pending focus and resolved Ask records remain usable across views.",
      "priority": "P1",
      "impact_paths": [
        "packages/web/src/components/workflows/AskCard*",
        "packages/web/src/experiments/console/components/ask/**",
        "packages/web/src/lib/*ask*"
      ],
      "scenarios": ["hitl.ask-draft", "hitl.ask-history", "hitl.awaiting-focus", "hitl.mobile-ask"]
    },
    {
      "id": "hitl.web-resume",
      "description": "Web-origin Ask resolution resumes through the parent conversation.",
      "priority": "P1",
      "scenarios": ["hitl.web-ask-resume"]
    },
    {
      "id": "hitl.reply",
      "description": "Replies target the exact parent; unavailable parents do not create conversations or approve Asks.",
      "priority": "P1",
      "scenarios": [
        "hitl.cli-composer",
        "hitl.console-reply-unavailable",
        "hitl.console-reply-parent"
      ]
    }
  ],
  "scenarios": [
