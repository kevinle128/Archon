ckgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43494560, "version": 1, "versionNonce": 1156246753, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "id": "t140", "type": "text", "x": 1490, "y": 638, "width": 243, "height": 12, "text": "open: how to return to Now? (close drawer)", "fontSize": 10, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "open: how to return to Now? (close drawer)", "lineHeight": 1.25, "index": "dX"}, {"angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 696561973, "version": 1, "versionNonce": 12345, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "id": "hyp-banner-1", "type": "text", "x": 40, "y": -140, "width": 1500, "height": 90.0, "text": "SKETCH HYPOTHESES \u2014 NOT stated by Kevin, to VALIDATE:\nH1: are both regions on screen AT ONCE, or one-then-switch? (Kevin said 'first Changes, then history' \u2014 a sequence)\nH2: is commit history grouped one-per-node, or a plain chronological commit list? (Kevin said history tells him what prior nodes did)\nValidate H1 & H2 SEPARATELY from viewer placement (V1/V2/V3).", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 18, "containerId": null, "originalText": "SKETCH HYPOTHESES \u2014 NOT stated by Kevin, to VALIDATE:\nH1: are both regions on screen AT ONCE, or one-then-switch? (Kevin said 'first Changes, then history' \u2014 a sequence)\nH2: is commit history grouped one-per-node, or a plain chronological commit list? (Kevin said history tells him what prior nodes did)\nValidate H1 & H2 SEPARATELY from viewer placement (V1/V2/V3).", "lineHeight": 1.25, "index": "y0"}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}