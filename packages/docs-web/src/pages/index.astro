---
// Archon marketing landing page.
//
// This page is `/`. The docs home is at `/docs/`. The page does not use
// Starlight, so the marketing surface can change on its own. It uses the
// shared site tokens and primitives in styles/site.css: navy top bar and
// statement panel, one blue accent, 2px and 1px rules, no radius, no shadow,
// no gradient. The theme (light or dark) is set by SiteHead.astro.
import '../styles/site.css';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';

const GITHUB = 'https://github.com/coleam00/Archon';

const features = [
  {
    label: 'Parallel by default',
    title: 'Run a fleet, not a task.',
    body: 'Every run gets its own git worktree. Point ten agents at ten problems at once — no collisions, no stepping on each other, no merge mess to untangle.',
  },
  {
    label: 'Anywhere',
    title: 'Ship from your phone.',
    body: 'Dispatch work from your terminal, Slack, Telegram, a GitHub comment, or the web. Kick it off, walk away, come back to finished pull requests.',
  },
  {
    label: 'Workflows as code',
    title: 'Your best patterns, packaged.',
    body: 'Capture review, planning, fixes, and feature work as YAML workflows — multi-step DAGs with loops, gates, and conditions. Write the play once. Run it forever.',
  },
  {
    label: 'Your agent',
    title: 'Bring your own model.',
    body: 'Claude Code, Codex, and more behind one command layer. Switch providers per workflow or per node. Archon orchestrates — you stay in control.',
  },
];

const steps = [
  { n: '01', title: 'Define', body: 'Write the workflow once in YAML — or use the bundled defaults.' },
  { n: '02', title: 'Dispatch', body: 'Fire it from anywhere. Each run spins up its own isolated worktree.' },
  { n: '03', title: 'Ship', body: 'Agents do the work in parallel. You review the pull requests.' },
];

const runSteps = [
  { n: '01', name: 'investigate', glyph: '✓', kind: 'CMD', state: 'done' },
  { n: '02', name: 'plan', glyph: '✓', kind: 'PRM', state: 'done' },
  { n: '03', name: 'implement', glyph: '▶', kind: 'CMD', state: 'running', note: '6m 02s' },
  { n: '04', name: 'validate', glyph: '○', kind: 'SH', state: 'pending' },
  { n: '05', name: 'review', glyph: '!', kind: 'GATE', state: 'waiting', note: 'Awaiting you' },
  { n: '06', name: 'create-pr', glyph: '○', kind: 'CMD', state: 'pending' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Archon — The command layer for your AI coding agents</title>
  <meta
    name="description"
    content="You were the bottleneck. Archon is the command layer for your AI coding agents — one developer, a fleet of work, dispatched from your terminal, Slack, or a GitHub comment."
  />
  <SiteHead />
  <meta property="og:title" content="Archon — The command layer for your AI coding agents" />
  <meta
    property="og:description"
    content="You were the bottleneck. Not anymore. One developer, a fleet of agents — dispatched from anywhere."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://archon.diy/" />
  <meta property="og:image" content="https://archon.diy/brand/assets/archon-logo.png" />
</head>
<body>
  <SiteHeader />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
      <div class="hero-copy">
        <p class="section-label hero-label">The command layer for your AI coding agents</p>
        <h1 class="hero-title">You were the bottleneck.</h1>
        <p class="hero-sub">
          One developer. A fleet of agents. Define your coding workflows once, then
          dispatch them from your terminal, Slack, or a GitHub comment — each running
          isolated, in parallel. The work scales without you at the desk.
        </p>

        <div class="cta-row">
          <a href="/getting-started/installation/" class="btn btn-primary">
            Get started
            <span aria-hidden="true">→</span>
          </a>
          <a href="/docs/" class="btn">Read the docs</a>
        </div>

        <pre class="code-block install"><code><span class="install-prompt">$</span> curl -fsSL https://archon.diy/install | bash</code></pre>
      </div>

      <div class="run" role="img" aria-label="Example run">
        <p class="run-meta">coleam00/archon · run 4f2a</p>
        <div class="run-head">
          <span class="run-title">fix-github-issue</span>
          <span class="run-state">▶ Running</span>
        </div>
        <div class="strip run-strip" aria-hidden="true">
          {runSteps.map((r) => <span class={`seg-${r.state}`}></span>)}
        </div>
        <ol class="run-rows" aria-hidden="true">
          {runSteps.map((r) => (
            <li class={`run-row is-${r.state}`}>
              <span class="run-n">{r.n}</span>
              <span class="run-main">
                <span class="run-glyph">{r.glyph}</span>
                <span class="run-name">{r.name}</span>
                <span class="run-kind">{r.kind}</span>
                {r.note && <span class="run-note">{r.note}</span>}
              </span>
            </li>
          ))}
        </ol>
      </div>
      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="manifesto">
      <p>
        The keyboard was never the job. <strong>Shipping</strong> was.
        Stop being the one hand on one task — <strong>direct the work, and step up a level.</strong>
      </p>
    </section>

    <!-- FEATURES -->
    <section class="features">
      {features.map((f) => (
        <article class="feature-card">
          <span class="section-label">{f.label}</span>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-body">{f.body}</p>
        </article>
      ))}
    </section>

    <!-- HOW IT WORKS -->
    <section class="how">
      <header class="section-head">
        <span class="section-label">How it works</span>
        <h2 class="section-title">Define. Dispatch. Ship.</h2>
      </header>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="step-n">{s.n}</span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- A DAY WITH ARCHON -->
    <section class="awe">
      <div class="awe-inner">
        <span class="section-label">A day with Archon</span>
        <p class="awe-line">
          Fire three agents from Slack on your phone. Walk the dog.
          <br />
          Come back to three pull requests.
        </p>
        <p class="awe-sub">
          Isolated worktrees mean they never collide. Multi-platform means you're never
          chained to the desk. That's the trade you always wanted.
        </p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final">
      <h2 class="final-title">Put the keyboard down.</h2>
      <p class="final-sub">Free, open source, and running on your machine in under a minute.</p>
      <div class="cta-row">
        <a href="/getting-started/installation/" class="btn btn-primary">
          Get started
          <span aria-hidden="true">→</span>
        </a>
        <a href={GITHUB} target="_blank" rel="noopener" class="btn">Star on GitHub</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="footer-word">Archon</span>
        <span class="footer-tag">The command layer for your AI coding agents.</span>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href="/getting-started/installation/">Install</a>
        <a href="/workflows/">Marketplace</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="/brand/">Brand</a>
        <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>
  </footer>

  <style>
    /* Page width and side gutter. The gutter is 16px or more at all widths. */
    .hero-inner,
    .manifesto,
    .features,
    .how,
    .awe-inner,
    .final,
    .footer-inner {
      max-width: 1080px;
      margin-inline: auto;
      padding-inline: 16px;
    }

    h1, h2, h3 { margin: 0; font-weight: 800; color: var(--text); }
    p { margin: 0; }

    /* Hero: navy statement panel. */
    .hero {
      background: var(--header-bg);
      color: var(--header-fg);
      border-bottom: 2px solid var(--rule);
    }
    .hero-inner { padding-block: 64px 40px; }
    .hero-label { color: var(--header-muted); margin-bottom: 16px; }
    .hero-title {
      max-width: 18ch;
      font-size: 44px;
      line-height: 1.05;
      color: var(--header-fg);
      margin-bottom: 20px;
    }
    .hero-sub {
      max-width: 60ch;
      font-size: 16px;
      line-height: 1.6;
      color: var(--header-muted);
      margin-bottom: 28px;
    }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
    .hero .btn:not(.btn-primary) { border-color: var(--header-line); }
    .install {
      max-width: 520px;
      margin-top: 28px;
      border: 1px solid var(--header-line);
      white-space: pre;
    }
    .install code { font-family: inherit; }
    .install-prompt { color: var(--code-muted); margin-right: 8px; }
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
      gap: 48px;
      align-items: center;
    }
    .hero-copy { min-width: 0; }
    .run {
      padding: 20px;
      border: 1px solid var(--header-line);
      background: var(--header-bg);
      color: var(--header-fg);
    }
    .run-meta { font-size: 12px; color: var(--header-muted); }
    .run-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 6px 0 14px; }
    .run-title { font-size: 20px; font-weight: 800; }
    .run-state { font-size: 12px; font-weight: 600; color: var(--header-accent); white-space: nowrap; }
    .run .strip > span { background: var(--header-line); }
    .run .strip > .seg-done { background: var(--status-done); }
    .run .strip > .seg-running { background: var(--header-accent); }
    .run .strip > .seg-waiting { background: var(--status-waiting); }
    .run-rows { list-style: none; margin: 14px 0 0; padding: 0; }
    .run-row {
      display: grid;
      grid-template-columns: 28px 1fr;
      align-items: center;
      padding: 9px 0 9px 8px;
      border-top: 1px solid var(--header-line);
      border-left: 3px solid transparent;
      font-size: 13px;
    }
    .run-row.is-running { border-left-color: var(--header-accent); }
    .run-n { font-size: 11px; color: var(--header-muted); }
    .run-main { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .run-glyph { width: 14px; text-align: center; }
    .is-done .run-glyph { color: var(--status-done); }
    .is-running .run-glyph { color: var(--header-accent); }
    .is-waiting .run-glyph { color: var(--status-waiting); }
    .is-pending .run-glyph { color: var(--header-muted); }
    .run-name { font-weight: 600; }
    .is-pending .run-name { color: var(--header-muted); }
    .run-kind { font-size: 10px; font-weight: 600; letter-spacing: 0.06em; color: var(--header-muted); }
    .run-note { margin-left: auto; font-size: 12px; white-space: nowrap; color: var(--header-fg); }
    .is-waiting .run-note { color: var(--status-waiting); }
    @media (max-width: 900px) {
      .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    }

    /* Manifesto. */
    .manifesto { padding-block: 56px 24px; }
    .manifesto p {
      max-width: 36ch;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.25;
      color: var(--text-2);
    }
    .manifesto strong { color: var(--text); font-weight: 800; }

    /* Features. */
    .features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      padding-block: 24px 40px;
    }
    .feature-card {
      padding: 24px;
      background: var(--card);
      border: 1px solid var(--line-strong);
    }
    .feature-title { font-size: 20px; line-height: 1.2; margin: 10px 0 8px; }
    .feature-body { font-size: 14px; line-height: 1.6; color: var(--text-2); }

    /* How it works. */
    .how { padding-block: 0 48px; }
    .section-head { border-top: 2px solid var(--rule); padding-top: 16px; margin-bottom: 8px; }
    .section-title { font-size: 28px; line-height: 1.1; margin-top: 8px; }
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 24px; }
    .step { padding: 16px 0; border-top: 1px solid var(--line); }
    .step-n { font-size: 11px; font-weight: 600; color: var(--text-3); letter-spacing: 0.08em; }
    .step-title { font-size: 18px; margin: 6px 0 4px; }
    .step-body { font-size: 14px; line-height: 1.6; color: var(--text-2); }

    /* A day with Archon. */
    .awe { border-top: 2px solid var(--rule); border-bottom: 1px solid var(--line); }
    .awe-inner { padding-block: 48px; }
    .awe-line {
      max-width: 28ch;
      font-size: 32px;
      font-weight: 800;
      line-height: 1.15;
      color: var(--text);
      margin: 12px 0 16px;
    }
    .awe-sub { max-width: 60ch; font-size: 16px; line-height: 1.6; color: var(--text-2); }

    /* Final call to action. */
    .final { padding-block: 56px; }
    .final-title { font-size: 32px; line-height: 1.1; margin-bottom: 8px; }
    .final-sub { font-size: 16px; color: var(--text-2); margin-bottom: 24px; }

    /* Footer. */
    .footer { border-top: 2px solid var(--rule); }
    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px 24px;
      padding-block: 24px;
    }
    .footer-brand { display: flex; flex-direction: column; gap: 2px; }
    .footer-word { font-size: 16px; font-weight: 800; color: var(--text); }
    .footer-tag { font-size: 12px; color: var(--text-2); }
    .footer-links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
    .footer-links a { color: var(--text-2); font-size: 13px; font-weight: 600; text-decoration: none; }
    .footer-links a:hover { color: var(--text); }

    @media (max-width: 820px) {
      .features,
      .steps { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .hero-inner { padding-block: 40px 28px; }
      .hero-title { font-size: 32px; }
      .manifesto p { font-size: 20px; }
      .awe-line { font-size: 26px; }
      .final-title { font-size: 26px; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>
</body>
</html>
