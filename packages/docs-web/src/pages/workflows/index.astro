---
import '../../styles/site.css';
import SiteHead from '../../components/SiteHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { marketplaceEntries, tagConfig } from '../../data/marketplace';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workflows — Archon</title>
    <meta
      name="description"
      content="Community-built Archon workflows. Browse, install, run."
    />
    <SiteHead />
  </head>
  <body>
    <SiteHeader active="/workflows/" />

    <main class="page">
      <header class="page-head">
        <h1>Workflows <span class="count">{marketplaceEntries.length}</span></h1>
        <p class="sub">Community-built Archon workflows. Browse, install, run.</p>
      </header>

      <div class="warning-banner">
        Community-submitted. Archon has not audited every workflow. Review the
        source before you install.
      </div>

      <div class="filter-bar">
        <input
          id="search-input"
          type="text"
          placeholder="Search workflows..."
          aria-label="Search workflows"
        />
        <div id="tag-filters" role="group" aria-label="Filter by category">
          <button
            type="button"
            class="tag-filter-btn active"
            data-tag=""
            aria-pressed="true"
          >
            All <span class="tab-count">{marketplaceEntries.length}</span>
          </button>
          {
            Object.entries(tagConfig).map(([key, cfg]) => (
              <button
                type="button"
                class="tag-filter-btn"
                data-tag={key}
                aria-pressed="false"
              >
                {cfg.label}{' '}
                <span class="tab-count">
                  {marketplaceEntries.filter((e) => e.tags.includes(key)).length}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div id="cards-grid" class="cards-grid">
        {
          marketplaceEntries.map((entry) => (
            <a
              class="card"
              href={`/workflows/${entry.slug}/`}
              data-name={entry.name.toLowerCase()}
              data-author={entry.author.toLowerCase()}
              data-description={entry.description.toLowerCase()}
              data-tags={entry.tags.join(',')}
              data-featured={entry.featured ? 'true' : 'false'}
            >
              <div class="card-header">
                <h3 class="card-title">{entry.name}</h3>
                {entry.featured && <span class="chip featured-badge">FEATURED</span>}
              </div>
              <p class="card-author">@{entry.author}</p>
              <p class="card-desc">{entry.description}</p>
              <div class="card-tags">
                {entry.tags.map((tag) => (
                  <span class="chip">{tagConfig[tag]?.label ?? tag}</span>
                ))}
              </div>
              <code class="code-block install-preview">
                archon workflow install {entry.slug}
              </code>
            </a>
          ))
        }
      </div>

      <div id="no-results" class="no-results" style="display: none;">
        No workflows match your search.
      </div>

      <footer class="footer">
        <p>
          Want to share a workflow? <a
            href="https://github.com/coleam00/Archon/blob/main/CONTRIBUTING.md"
            >See our contributing guide →</a
          >
        </p>
      </footer>
    </main>

    <script is:inline>
      (function () {
        var searchInput = document.getElementById('search-input');
        var tagButtons = document.querySelectorAll('.tag-filter-btn');
        var cards = document.querySelectorAll('.card');
        var noResults = document.getElementById('no-results');
        var activeTag = '';

        function applyFilter() {
          var query = searchInput.value.toLowerCase();
          var visibleCount = 0;
          cards.forEach(function (card) {
            var matchesSearch =
              !query ||
              card.dataset.name.includes(query) ||
              card.dataset.author.includes(query) ||
              card.dataset.description.includes(query) ||
              card.dataset.tags.includes(query);
            var matchesTag =
              !activeTag || card.dataset.tags.split(',').includes(activeTag);
            var visible = matchesSearch && matchesTag;
            card.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
          });
          noResults.style.display = visibleCount === 0 ? '' : 'none';
        }

        searchInput.addEventListener('input', applyFilter);
        tagButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var tag = btn.dataset.tag;
            activeTag = activeTag === tag ? '' : tag;
            tagButtons.forEach(function (b) {
              var on = b.dataset.tag === activeTag;
              b.classList.toggle('active', on);
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            applyFilter();
          });
        });
      })();
    </script>

    <style>
      .page {
        max-width: 880px;
        margin: 0 auto;
        padding: 32px 24px 48px;
      }
      .page-head {
        padding-bottom: 12px;
        margin-bottom: 16px;
        border-bottom: 2px solid var(--rule);
      }
      .page-head h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        line-height: 1.15;
        color: var(--text);
      }
      .count {
        margin-left: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-2);
      }
      .sub {
        margin: 4px 0 0;
        font-size: 14px;
        color: var(--text-2);
      }
      .warning-banner {
        margin-bottom: 16px;
        padding: 10px 16px;
        background: var(--surface);
        border-left: 3px solid var(--status-waiting);
        color: var(--text);
        font-size: 13px;
      }
      .filter-bar {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 0;
      }
      #search-input {
        width: 100%;
        height: 36px;
        padding: 0 12px;
        background: var(--card);
        border: 1px solid var(--line-strong);
        color: var(--text);
        font: 400 13px var(--font);
      }
      #search-input::placeholder {
        color: var(--text-3);
      }
      #tag-filters {
        display: flex;
        overflow-x: auto;
        border-bottom: 1px solid var(--line);
        scrollbar-width: none;
      }
      #tag-filters::-webkit-scrollbar {
        display: none;
      }
      .tag-filter-btn {
        flex: none;
        padding: 8px 12px;
        margin-bottom: -1px;
        background: transparent;
        border: 0;
        border-bottom: 2px solid transparent;
        color: var(--text-2);
        font: 600 12px var(--font);
        cursor: pointer;
      }
      .tab-count {
        margin-left: 4px;
        font-weight: 400;
        color: var(--text-3);
      }
      .tag-filter-btn:hover {
        color: var(--text);
      }
      .tag-filter-btn.active {
        color: var(--text);
        border-bottom-color: var(--accent);
      }
      .cards-grid {
        display: block;
      }
      .card {
        display: block;
        padding: 16px;
        border-bottom: 1px solid var(--line);
        border-left: 3px solid transparent;
        color: var(--text);
        text-decoration: none;
      }
      .card[data-featured='true'] {
        border-left-color: var(--accent);
      }
      .card:hover {
        background: var(--selection);
      }
      .card-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }
      .card-title {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
      }
      .featured-badge {
        color: var(--accent-text);
        border-color: var(--accent);
        letter-spacing: 0.06em;
      }
      .card-author {
        margin: 2px 0 8px;
        font-size: 12px;
        color: var(--text-2);
      }
      .card-desc {
        margin: 0 0 12px;
        font-size: 14px;
        color: var(--text-2);
      }
      .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
      }
      .install-preview {
        display: block;
        padding: 8px 12px;
        font-size: 12px;
      }
      .no-results {
        padding: 32px 16px;
        text-align: center;
        color: var(--text-2);
      }
      .footer {
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
        color: var(--text-2);
        font-size: 13px;
      }
      @media (max-width: 640px) {
        .page {
          padding: 24px 16px 40px;
        }
      }
    </style>
  </body>
</html>
