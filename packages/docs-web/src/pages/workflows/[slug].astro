---
import '../../styles/site.css';
import SiteHead from '../../components/SiteHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { marketplaceEntries, tagConfig } from '../../data/marketplace';

export function getStaticPaths() {
  return marketplaceEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const sourceAtSha = entry.sourceUrl.replace(/\/blob\/[^/]+\//, `/blob/${entry.sha}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.name} — Archon Workflows</title>
    <meta name="description" content={entry.description} />
    <SiteHead />
  </head>
  <body>
    <SiteHeader active="/workflows/" />

    <main class="page">
      <p class="context">
        <a href="/workflows/">Workflows</a> <span>›</span> <span>{entry.name}</span>
      </p>
      <h1>{entry.name}</h1>

      <dl class="meta">
        <dt>Author</dt>
        <dd>
          <a
            href={`https://github.com/${entry.author}`}
            target="_blank"
            rel="noopener">@{entry.author}</a
          >
        </dd>
        <dt>Compatible</dt>
        <dd>{entry.archonVersionCompat}</dd>
        <dt>Tags</dt>
        <dd class="tags">
          {
            entry.tags.map((tag) => (
              <span class="chip">{tagConfig[tag]?.label ?? tag}</span>
            ))
          }
        </dd>
      </dl>

      <p class="description">{entry.description}</p>

      <section>
        <h2 class="section-label">Install</h2>
        <div class="code-block install-row">
          <code>archon workflow install {entry.slug}</code>
          <button
            type="button"
            class="btn btn-primary copy-btn"
            data-copy={`archon workflow install ${entry.slug}`}>Copy</button
          >
        </div>
      </section>

      <section>
        <h2 class="section-label">Source</h2>
        <p class="source-note">
          Pinned to commit <code class="sha">{entry.sha.slice(0, 8)}</code>
        </p>
        <a href={sourceAtSha} target="_blank" rel="noopener" class="btn"
          >View YAML on GitHub →</a
        >
      </section>

      <a href="/workflows/" class="back-link">← Back to all workflows</a>
    </main>

    <script is:inline>
      document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText(btn.dataset.copy).then(function () {
            btn.textContent = 'Copied!';
            setTimeout(function () {
              btn.textContent = 'Copy';
            }, 2000);
          });
        });
      });
    </script>

    <style>
      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 24px 24px 48px;
      }
      .context {
        margin: 0 0 4px;
        font-size: 12px;
        color: var(--text-2);
      }
      .context a {
        color: var(--text-2);
      }
      h1 {
        margin: 0 0 16px;
        font-size: 24px;
        font-weight: 800;
        line-height: 1.15;
        color: var(--text);
      }
      .meta {
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 6px 0;
        margin: 0 0 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
      }
      .meta dt {
        color: var(--text-2);
      }
      .meta dd {
        margin: 0;
        font-weight: 600;
        color: var(--text);
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .description {
        margin: 0 0 32px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--text-2);
      }
      section {
        margin-bottom: 32px;
      }
      section .section-label {
        margin-bottom: 8px;
      }
      .install-row {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .install-row code {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        white-space: nowrap;
      }
      .copy-btn {
        flex: none;
        min-height: 32px;
        padding: 0 12px;
        font-size: 12px;
      }
      .source-note {
        margin: 0 0 12px;
        font-size: 13px;
        color: var(--text-2);
      }
      .sha {
        padding: 1px 6px;
        background: var(--surface);
        color: var(--text);
        font-size: 12px;
      }
      .back-link {
        font-size: 13px;
        color: var(--text-2);
      }
      @media (max-width: 640px) {
        .page {
          padding: 20px 16px 40px;
        }
        .meta {
          grid-template-columns: 80px 1fr;
        }
      }
    </style>
  </body>
</html>
