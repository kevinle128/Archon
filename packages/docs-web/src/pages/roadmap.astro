---
import '../styles/site.css';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { roadmapItems } from '../data/roadmap.ts';
import type { RoadmapStatus } from '../data/roadmap.ts';

type Item = (typeof roadmapItems)[number];

// Status language of the product: glyph, label, and color token for each state.
const statusView: Record<RoadmapStatus, { glyph: string; label: string; color: string }> = {
  'in-progress': { glyph: '▶', label: 'In progress', color: 'var(--status-running)' },
  next: { glyph: '○', label: 'Next', color: 'var(--text-2)' },
  planned: { glyph: '○', label: 'Planned', color: 'var(--status-pending)' },
  shipped: { glyph: '✓', label: 'Shipped', color: 'var(--status-done)' },
};

const isSecondary = (i: Item) => i.tier === 'secondary';
const sections: { key: string; label: string; items: Item[] }[] = [
  { key: 'active', label: 'Roadmap', items: roadmapItems.filter((i) => i.status !== 'shipped' && !isSecondary(i)) },
  { key: 'future', label: 'Future', items: roadmapItems.filter((i) => i.status !== 'shipped' && isSecondary(i)) },
  { key: 'shipped', label: 'Shipped', items: roadmapItems.filter((i) => i.status === 'shipped') },
].filter((s) => s.items.length > 0);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Roadmap — Archon</title>
  <meta name="description" content="What we're building next — Archon's public development roadmap." />
  <SiteHead />
</head>
<body>
  <SiteHeader active="/roadmap/" />

  <main class="page">
    <header class="page-head">
      <h1>Roadmap</h1>
      <p>What we're building next.</p>
    </header>

    {sections.map((section) => (
      <section class="group" aria-labelledby={`group-${section.key}`}>
        <h2 class="section-label group-label" id={`group-${section.key}`}>{section.label}</h2>
        <ol class="steps">
          {section.items.map((item, index) => {
            const view = statusView[item.status];
            return (
              <li class="step" style={`--bar: ${view.color};`}>
                <span class="step-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="step-body">
                  <div class="step-head">
                    <span class="status" style={`color: ${view.color};`}>
                      <span aria-hidden="true">{view.glyph}</span> {view.label}
                    </span>
                    {item.version && <span class="chip">{item.version}</span>}
                  </div>
                  <h3 class="step-title">{item.title}</h3>
                  <p class="step-desc">{item.description}</p>
                  {item.bullets.length > 0 && (
                    <ul class="bullets">
                      {item.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  )}
                  <div class="chips">
                    {item.tags.map((t) => <span class="chip">{t}</span>)}
                  </div>
                  {item.issues && item.issues.length > 0 && (
                    <div class="issues">
                      <span class="section-label">Tracked issues</span>
                      <div class="chips">
                        {item.issues.map((n) => (
                          <a class="chip issue-ref" href={`https://github.com/coleam00/Archon/issues/${n}`} target="_blank" rel="noopener">#{n}</a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <footer class="page-foot">
      Have a feature request?{' '}
      <a href="https://github.com/coleam00/Archon/issues" target="_blank" rel="noopener">Open an issue on GitHub →</a>
    </footer>
  </main>

  <style>
    /* One left-aligned column, like the settings content of the product. */
    .page {
      max-width: 880px;
      margin: 0;
      padding: 32px 32px 64px;
    }
    .page-head {
      padding-bottom: 16px;
      border-bottom: 2px solid var(--rule);
    }
    .page-head h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 800;
      line-height: 1.2;
    }
    .page-head p {
      margin: 4px 0 0;
      color: var(--text-2);
    }
    .group {
      margin-top: 32px;
    }
    .group-label {
      margin-bottom: 8px;
    }
    .steps {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    /* Each step: 1px top rule, 3px status bar on the left, number column. */
    .step {
      display: grid;
      grid-template-columns: 28px 1fr;
      padding: 16px 0 16px 12px;
      border-top: 1px solid var(--line);
      border-left: 3px solid var(--bar);
    }
    .step-num {
      padding-top: 3px;
      color: var(--text-3);
      font-size: 11px;
    }
    .step-body {
      min-width: 0;
    }
    .step-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .status {
      font-size: 12px;
      font-weight: 600;
    }
    .step-title {
      margin: 8px 0 0;
      font-size: 18px;
      font-weight: 800;
      line-height: 1.3;
    }
    .step-desc {
      max-width: 64ch;
      margin: 4px 0 0;
      color: var(--text-2);
    }
    .bullets {
      margin: 12px 0 0;
      padding: 0;
      list-style: none;
    }
    .bullets li {
      position: relative;
      padding-left: 16px;
      margin-top: 4px;
    }
    .bullets li::before {
      content: '–';
      position: absolute;
      left: 0;
      color: var(--text-3);
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 12px;
    }
    .issues {
      margin-top: 12px;
    }
    .issues .chips {
      margin-top: 4px;
    }
    .issue-ref {
      color: var(--accent-text);
      text-decoration: none;
    }
    .issue-ref:hover {
      background: var(--selection);
    }
    .page-foot {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
      color: var(--text-2);
    }
    @media (max-width: 640px) {
      .page {
        padding: 24px 16px 48px;
      }
    }
  </style>
</body>
</html>
