---
// The 7x7 pixel "A" of the brand guide. A `#` is a filled pixel.
// The pixels use the current text color.
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
const ROWS = ['..###..', '.##.##.', '##...##', '#######', '##...##', '##...##', '##...##'];
const CELL = 8;
const PAD = 4;
const pixels = ROWS.flatMap((row, y) =>
  row.split('').flatMap((cell, x) => (cell === '#' ? [{ x: PAD + x * CELL, y: PAD + y * CELL }] : []))
);
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  shape-rendering="crispEdges"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  {pixels.map(({ x, y }) => <rect x={x} y={y} width={CELL} height={CELL} />)}
</svg>
